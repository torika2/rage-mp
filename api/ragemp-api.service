# Install:  sudo cp /opt/ragemp-srv/api/ragemp-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now ragemp-api
# Logs:     journalctl -u ragemp-api -f
[Unit]
Description=RAGE:MP Backend API (NestJS + MySQL)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=torik
WorkingDirectory=/opt/ragemp-srv/api
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
